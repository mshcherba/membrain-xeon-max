{
  "name": "QMCPACK 4.3.9 (Quantum Monte Carlo - NiO S64)",
  "binary_path": "../../../qmcpack/build_membrain/bin/qmcpack",
  "allocation_sites_path": "../../../qmcpack/build_membrain/allocation_sites.json",
  "working_dir": ".",
  "fom_unit": "1/s",
  "default_args": [
    "NiO-fcc-S64.xml"
  ],
  "patterns": {
    "fom": "DMC Execution time[\\s\\S]*?FOM\\s*=\\s*([\\d\\.e\\+\\-]+)",
    "elapsed_sec": "(?:DMC|VMC|Total) Execution time\\s*=\\s*([\\d\\.e\\+\\-]+)",
    "total_sec": "Total Execution time\\s*=\\s*([\\d\\.e\\+\\-]+)",
    "init_sec": "Initialization Execution time\\s*=\\s*([\\d\\.e\\+\\-]+)"
  }
}
