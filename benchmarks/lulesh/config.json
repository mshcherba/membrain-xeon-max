{
  "name": "LULESH 2.0 (Livermore Unstructured Lagrangian Explicit Shock Hydrodynamics)",
  "binary_path": "../../../LULESH/build/lulesh2.0",
  "allocation_sites_path": "../../../LULESH/build/allocation_sites.json",
  "default_max_rss_kb": 57650856,
  "fom_unit": "z/s",
  "default_args": [
    "-s", "400",
    "-i", "5",
    "-r", "11",
    "-b", "0",
    "-c", "64",
    "-p"
  ],
  "environment": {
    "OMP_NUM_THREADS": "32",
    "KMP_AFFINITY": "granularity=fine,compact,1,0"
  },
  "patterns": {
    "fom": "FOM\\s*=\\s*([\\d\\.]+)",
    "elapsed_sec": "Elapsed time\\s*=\\s*([\\d\\.e\\+\\-]+)",
    "grind_time_us": "Grind time.*=\\s*([\\d\\.]+)"
  }
}
